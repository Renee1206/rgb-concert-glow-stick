// 把所有 RBG 調色盤鎖住
void closeAll() {
    Blynk.setProperty(V0, "isDisabled", 1);
    Blynk.setProperty(V1, "isDisabled", 1);
    Blynk.setProperty(V2, "isDisabled", 1);
    Blynk.setProperty(V3, "isDisabled", 1);
    Blynk.setProperty(V4, "isDisabled", 1);
}

// V102:模式切換
BLYNK_WRITE(V102) {
    mode = param.asInt();
    Blynk.virtualWrite(V103, 0);

    switch (mode) {
        // 音樂燈光秀
        case 1:
            closeAll();
            break;
        // 廣播
        case 2:
            closeAll();
            Blynk.setProperty(V0, "isDisabled", 0);
            break;
        // Binary Count
        case 3:
            closeAll();
            xTaskCreate(mode3Thread, "mode3Thread", 8192, NULL, 1, NULL);
            break;
        // 呼吸燈
        case 4:
            closeAll();
            xTaskCreate(mode4Thread, "mode4Thread", 8192, NULL, 1, NULL);
            break;
    }
}

// 處理音樂燈光秀的 thread
void mode1Thread(void* pvParameters) {
    // 在序列埠輸出 START 的字串，Py 程式接收到後開始播放音樂
    Serial.println("START");

    int alreadySend = 0;
    long previousMillis = millis();
    while (millis() - previousMillis < 173000) {
        // 根據時間間隔的 array 依序送出資料
        if (millis() - previousMillis >= mode1Time[alreadySend]) {
            if (mode == 1) {
                udp.beginPacket(broadcastIP, udpPort);
                // UPD 傳送須符合特定格式
                udp.write((uint8_t*)mode1Msg[alreadySend].c_str(), mode1Msg[alreadySend].length());
                udp.endPacket();
                Serial.println(mode1Msg[alreadySend]);
            }
            alreadySend++;
        }
    }
    Blynk.setProperty(V6, "isDisabled", 0);
    Blynk.virtualWrite(V6, 0);

    vTaskDelete(NULL);
}

// 處理 Binary Counter 的 thread
void mode3Thread(void* pvParameters) {
    int alreadySend = 0;
    long previousMillis = millis();

    while (mode == 3) {
        // 根據時間間隔的 array 依序送出資料
        if (millis() - previousMillis >= mode3Time[alreadySend]) {
            udp.beginPacket(broadcastIP, udpPort);
            udp.write((uint8_t*)mode3Msg[alreadySend].c_str(), mode1Msg[alreadySend].length());
            udp.endPacket();
            Serial.println(mode3Msg[alreadySend]);
            alreadySend += 1;
        }
        // 循環播放
        if (alreadySend >= mode3Size - 1) {
            previousMillis = millis();
            alreadySend = 0;
        }
    }
    vTaskDelete(NULL);
}

// 處理呼吸燈的 thread
void mode4Thread(void* pvParameters) {
    int rgb = 255;
    int direction = -1;
    String msg = "";

    while (mode == 4) {
        msg = "[";

        for (int i = 1; i <= 4; i++) {
            int currentRgb = rgb;
            // 讓 1 號 4 號一組，2 號 3 號一組
            if (i == 2 || i == 3) {
                // 互補色
                currentRgb = 255 - rgb;
            }
            msg += String(i) + ":" + String(currentRgb) + "/" + String(currentRgb) + "/" + String(currentRgb) + "/0";
            if (i < 4) {
                msg += ",";
            }
        }

        msg += "]";

        udp.beginPacket(broadcastIP, udpPort);
        udp.write((uint8_t*)msg.c_str(), msg.length());
        udp.endPacket();
        Serial.println(msg);

        // 範圍是 0 ~ 255，超過或低於就轉向
        rgb += direction;
        if (rgb <= 0) {
            rgb = 0;
            direction = 1;
        } else if (rgb >= 255) {
            rgb = 255;
            direction = -1;
        }

        // 每 10ms 變換一次
        vTaskDelay(10 / portTICK_PERIOD_MS);
    }
    vTaskDelete(NULL);
}

// V103:切換成單播模式
BLYNK_WRITE(V103) {
    mode = 6;
    Blynk.virtualWrite(V102, 5);

    Blynk.setProperty(V0, "isDisabled", 1);
    Blynk.setProperty(V1, "isDisabled", 0);
    Blynk.setProperty(V2, "isDisabled", 0);
    Blynk.setProperty(V3, "isDisabled", 0);
    Blynk.setProperty(V4, "isDisabled", 0);
}

// 使用 UDP 把訊息傳送給 Client
void sendMessageFunc() {
    sendMessage = "[" + led1Message + led2Message + led3Message + led4Message + "]";

    udp.beginPacket(broadcastIP, udpPort);
    // UDP 傳送資料須符合特定 Type
    udp.write((uint8_t*)sendMessage.c_str(), sendMessage.length());
    udp.endPacket();
    Serial.println(sendMessage);
}

void setup() {
    Serial.begin(115200);
    Serial.println();
    Serial.println("==================================");

    // 關閉看門狗的功能
    esp_task_wdt_deinit();

    // 連接上手機的 Wi-Fi
    WiFi.begin(ssid, password);

    // 關閉 Wi-Fi 的省電模式
    esp_wifi_set_ps(WIFI_PS_NONE);

    while (WiFi.status() != WL_CONNECTED) {
        delay(1000);
        Serial.println("Connecting to Wi-Fi......");
    }
    Serial.println("Wi-Fi connected successfully!");
    Serial.println("==================================");

    // 連接 Blynk 伺服器
    Blynk.begin(BLYNK_AUTH_TOKEN, ssid, password);
    Serial.println("==================================");

    // 5 組 RGB
    Blynk.setProperty(V0, "isDisabled", 1);
    Blynk.setProperty(V1, "isDisabled", 1);
    Blynk.setProperty(V2, "isDisabled", 1);
    Blynk.setProperty(V3, "isDisabled", 1);
    Blynk.setProperty(V4, "isDisabled", 1);

    // 音樂播放
    Blynk.setProperty(V6, "isDisabled", 0);
    Blynk.virtualWrite(V6, 0);

    Blynk.setProperty(V102, "isDisabled", 0);
    Blynk.virtualWrite(V102, 1);  // 1:音樂燈光秀，2:V0控制，3:，4:，5:關掉
    Blynk.virtualWrite(V103, 0);  // 0:關掉，1:單播
    mode = 1;
}

void loop() {
    Blynk.run();
}
